{
  "name": "my-link-shortener",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Cloudflare Workers URL shortener SaaS — links, domain parking, email, page extraction",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareEnv src/worker-env.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.8.0",
    "nanoid": "^5.1.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.62.0"
  }
}
